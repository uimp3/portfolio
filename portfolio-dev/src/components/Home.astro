---
import { Image } from "astro:assets";
import portraitLight from "../assets/lightPortrait.jpeg";
import portraitDark from "../assets/portrait.jpeg";

interface SocialLink {
  name: string;
  url: string;
  icon: string;
  showInContact: boolean;
}

interface LocaleData {
  hero: {
    subtitle: string;
  };
  home: {
    intro: string;
    socials: SocialLink[];
  };
}

const { locale } = Astro.props as { locale: LocaleData };

const getSocialIcon = (name: string): string => {
  const iconMap: Record<string, string> = {
    GitHub: "fa-brands fa-github",
    LinkedIn: "fa-brands fa-linkedin",
    Email: "fa-solid fa-envelope",
    Whatsapp: "fa-brands fa-whatsapp"
  };
  return iconMap[name] || "fa-solid fa-link";
};
---
<section id="home" class="hero">
                <div class="hero-content ">
                    <div class="portrait-container ">
                        <Image src={portraitLight} alt="me" class="portrait-light"/>
                        <Image src={portraitDark} alt="me" class="portrait-dark"/>
                    </div>

                    <div class="hero-text">
                        <h1>Edwin Muñoz</h1>

                        <p class="hero-subtitle">
                            {locale.hero.subtitle}
                        </p>

                        <p class="hero-about">
                            {locale.home.intro}
                        </p>

                        <div class="social-links">
                            {locale.home.socials.map((social) => (
                                social.url ? (
                                    <a
                                        href={social.url}
                                        target={social.name === 'Email' ? '_self' : '_blank'}
                                        aria-label={social.name}
                                    >
                                        <i class={getSocialIcon(social.name)}></i>
                                    </a>
                                ) : null
                            ))}
                        </div>
                    </div>
                </div>
            </section>