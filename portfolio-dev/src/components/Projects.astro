---
import { Icon } from "astro-icon/components";

interface Project {
  name: string;
  description: string;
  technologies: string[];
  link: string;
}

interface LocaleData {
  projects: {
    title: string;
    subtitle: string;
    projects: Project[];
  };
}

const { locale } = Astro.props as { locale: LocaleData };
---

<section id="projects" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-16 project-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> {locale.projects.title}
        </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        {locale.projects.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {locale.projects.projects.map((project) => (
        <div class="project-card opacity-0 group flex flex-col p-6 rounded-2xl bg-accent/5 border border-accent/10 hover:border-accent/40 hover:bg-accent/10 transition-all duration-300">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="text-maintext font-heading font-bold text-lg">
              {project.name}
            </h3>
            {project.link && project.link !== "#" && (
              <a
                href={project.link}
                target="_blank"
                aria-label={project.name}
                class="shrink-0 text-subtext hover:text-accent transition-colors"
              >
                <Icon name="mdi:open-in-new" class="w-5 h-5" />
              </a>
            )}
          </div>

          <p class="text-subtext font-body text-sm leading-relaxed mb-5 flex-1">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-accent/10 text-accent border border-accent/20">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


<style>
  /* Header Initial State */
  .project-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Cards Initial State */
  .project-card {
    opacity: 0; /* Ensuring cards start hidden too */
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shared Revealed State */
  .project-header.reveal,
  .project-card.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  const initProjectReveal = () => {
    const header = document.querySelector('.project-header');
    const cards = document.querySelectorAll('.project-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          
          // Check if the intersecting element is the header
          if (target.classList.contains('project-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } 
          // Check if the intersecting element is a project card
          else if (target.classList.contains('project-card')) {
            const index = Array.from(cards).indexOf(target);
            
            // Stagger effect based on row position (only for cards)
            setTimeout(() => {
              target.classList.add('reveal');
            }, (index % 3) * 150);
            
            observer.unobserve(target);
          }
        }
      });
    }, { 
      threshold: 0.15, 
      rootMargin: '0px 0px -10px 0px' 
    });

    // Observe the header
    if (header) observer.observe(header);
    
    // Observe all cards
    cards.forEach(card => observer.observe(card));
  };

  window.addEventListener('load', initProjectReveal);

  // Support for Astro View Transitions
  document.addEventListener('astro:after-swap', initProjectReveal);
</script>