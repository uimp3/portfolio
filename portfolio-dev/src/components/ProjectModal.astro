---
import { Icon } from "astro-icon/components";
import type { ProjectCardData } from "../utils/projectsData";

interface Props {
  projects: ProjectCardData[];
}

const { projects } = Astro.props;
---

<div class="project-modal" data-project-modal hidden aria-hidden="true">
  <div class="project-modal-backdrop" data-modal-close></div>
  <div class="project-modal-panel" role="dialog" aria-modal="true" aria-labelledby="project-modal-title">
    <button type="button" class="project-modal-close" data-modal-close aria-label="Close gallery">
      <Icon name="mdi:close" class="w-5 h-5" />
    </button>

    <div class="project-modal-media">
      <button type="button" class="project-modal-nav project-modal-prev" data-modal-prev aria-label="Previous image">
        <Icon name="mdi:chevron-left" class="w-6 h-6" />
      </button>

      <figure class="project-modal-frame">
        <img data-modal-image src="" alt="" class="project-modal-image" />
      </figure>

      <button type="button" class="project-modal-nav project-modal-next" data-modal-next aria-label="Next image">
        <Icon name="mdi:chevron-right" class="w-6 h-6" />
      </button>
    </div>

    <div class="project-modal-footer">
      <div>
        <h3 id="project-modal-title" data-modal-title class="text-lg font-heading font-bold text-maintext"></h3>
        <p class="text-sm text-subtext mt-1" data-modal-counter></p>
      </div>
      <a href="#" target="_blank" class="project-modal-link" data-modal-link>
        <Icon name="mdi:open-in-new" class="w-4 h-4" />
        <span>Open project</span>
      </a>
    </div>
  </div>
</div>

<script type="application/json" id="project-data" set:html={JSON.stringify(projects)}></script>

<style>
  .project-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  .project-modal[hidden] {
    display: none;
  }

  .project-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 18, 0.82);
    backdrop-filter: blur(14px);
  }

  .project-modal-panel {
    position: relative;
    z-index: 1;
    width: min(92vw, 920px);
    margin: 6vh auto 0;
    border-radius: 1.5rem;
    background: rgba(10, 14, 24, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
    padding: 1rem;
  }

  .project-modal-close,
  .project-modal-nav,
  .project-modal-link {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.06);
    color: rgb(255, 255, 255);
  }

  .project-modal-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    z-index: 2;
  }

  .project-modal-media {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }

  .project-modal-frame {
    margin: 0;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    aspect-ratio: 16 / 10;
  }

  .project-modal-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .project-modal-nav {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
  }

  .project-modal-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
  }

  .project-modal-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
  }
</style>

<script>
  const initProjectModal = () => {
    const modal = document.querySelector('[data-project-modal]');
    const modalImage = document.querySelector('[data-modal-image]');
    const modalTitle = document.querySelector('[data-modal-title]');
    const modalCounter = document.querySelector('[data-modal-counter]');
    const modalLink = document.querySelector('[data-modal-link]');
    const prevButton = document.querySelector('[data-modal-prev]');
    const nextButton = document.querySelector('[data-modal-next]');
    const closeButtons = document.querySelectorAll('[data-modal-close]');
    const galleryTriggers = document.querySelectorAll('[data-gallery-trigger]');
    const projectData = document.getElementById('project-data');
    const projects = projectData ? JSON.parse(projectData.textContent || '[]') : [];

    let activeProjectIndex = 0;
    let activeImageIndex = 0;

    const renderModal = () => {
      const project = projects[activeProjectIndex];
      const image = project.gallery[activeImageIndex];

      if (!modal || !modalImage || !modalTitle || !modalCounter || !modalLink) {
        return;
      }

      modalImage.setAttribute('src', image.src);
      modalImage.setAttribute('alt', image.alt);
      const titleParts = project.name.replace(/[-_]+/g, ' ').split(' ');
      let formattedTitle = '';

      for (let index = 0; index < titleParts.length; index += 1) {
        const word = titleParts[index];
        if (!word) {
          continue;
        }

        formattedTitle += `${formattedTitle ? ' ' : ''}${word.charAt(0).toUpperCase()}${word.slice(1)}`;
      }

      modalTitle.textContent = formattedTitle;
      modalCounter.textContent = `${activeImageIndex + 1} / ${project.gallery.length}`;
      modalLink.setAttribute('href', project.htmlUrl || '#');
      modalLink.setAttribute('target', '_blank');
      modalLink.setAttribute('rel', 'noopener noreferrer');
    };

    const openModal = (projectIndex: number) => {
      activeProjectIndex = projectIndex;
      activeImageIndex = 0;
      renderModal();
      modal?.removeAttribute('hidden');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal?.setAttribute('hidden', '');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const goToImage = (delta: number) => {
      const project = projects[activeProjectIndex];
      activeImageIndex = (activeImageIndex + delta + project.gallery.length) % project.gallery.length;
      renderModal();
    };

    galleryTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const parent = trigger.closest('[data-project-index]');
        const projectIndex = parent ? Number(parent.getAttribute('data-project-index')) : 0;
        openModal(projectIndex);
      });
    });

    prevButton?.addEventListener('click', () => goToImage(-1));
    nextButton?.addEventListener('click', () => goToImage(1));
    closeButtons.forEach((button) => button.addEventListener('click', closeModal));

    modal?.addEventListener('click', (event) => {
      if (event.target instanceof HTMLElement && event.target.matches('[data-modal-close]')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (modal?.hasAttribute('hidden')) {
        return;
      }

      if (event.key === 'Escape') {
        closeModal();
      }

      if (event.key === 'ArrowLeft') {
        goToImage(-1);
      }

      if (event.key === 'ArrowRight') {
        goToImage(1);
      }
    });
  };

  window.addEventListener('load', initProjectModal);

  // Support for Astro View Transitions
  document.addEventListener('astro:after-swap', initProjectModal);
</script>